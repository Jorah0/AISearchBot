# Copy to .env (or put values in the vault: lodestar vault set NAME). Env wins over vault.
# --- AI providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# OLLAMA_MODEL=llama3.1          # enables local Ollama
# LODESTAR_PROVIDER=anthropic      # default provider (else first configured)
# ANTHROPIC_MODEL=claude-sonnet-5-5   # per-provider model override: <PROVIDER>_MODEL

# --- email monitor (Gmail: enable IMAP + App Password) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASS=
# LODESTAR_NOTIFY_EMAIL=you@example.com   # email yourself alerts (uses SMTP_HOST, default smtp.gmail.com)

# LODESTAR_HOME=~/.lodestar          # data dir override
