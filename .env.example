# Copy to .env (or put values in the vault: lodestar vault set NAME). Env wins over vault.
# --- AI providers (set at least one) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
# OLLAMA_MODEL=llama3.1          # enables local Ollama
# LODESTAR_PROVIDER=anthropic      # default provider (else first configured)
# ANTHROPIC_MODEL=claude-sonnet-5-5   # per-provider model override: <PROVIDER>_MODEL

# --- email: prefer `lodestar email connect` or Setup > Connect email (keyring). Values set here WIN over it. ---
# IMAP_USER=
# IMAP_PASS=                        # an app password, never your normal one
# IMAP_HOST=imap.gmail.com
# IMAP_PORT=993
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_MODE=ssl                     # or starttls (port 587)
# LODESTAR_NOTIFY_EMAIL=you@example.com   # email yourself alerts (sent from the connected mailbox)

# --- market pay (pref market_pay) ---
# BLS_API_KEY=                     # optional, free: 500 BLS queries a day instead of 25 (renew it yearly)

# LODESTAR_HOME: set it as an environment variable, not here (a .env line is read after the data folder is chosen)
# LODESTAR_VAULT_SERVICE=lodestar   # fixed keyring service; unset: lodestar for ~/.lodestar, its own for any other home
