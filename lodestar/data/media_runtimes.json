{
  "_note": "Local generation runtimes (pass 59, lodestar/media.py). Loopback only. VRAM figures are publisher-reported, in GB as published; null means unknown (not measured here).",
  "comfyui": {
    "label": "ComfyUI",
    "base": "http://127.0.0.1:8188",
    "health": "/system_stats",
    "models": "/models/checkpoints",
    "submit": "/prompt",
    "history": "/history",
    "view": "/view",
    "operations": ["text->image", "text->music", "image->mesh"],
    "probe_only": false,
    "experimental": false,
    "vram": [
      {"model": "Hunyuan3D 2.1", "operation": "image->mesh", "unit": "GB", "label": "publisher-reported",
       "figures": {"shape": 10, "texture": 21, "combined": 29},
       "source": "Tencent Hunyuan3D-2.1 model card"}
    ],
    "templates": {
      "sdxl_text_to_image": {
        "_fill_in": "Set node 4 ckpt_name to your SDXL checkpoint file name (as listed in ComfyUI/models/checkpoints). media.sdxl_workflow() fills prompt, size, seed and steps.",
        "4": {"class_type": "CheckpointLoaderSimple", "inputs": {"ckpt_name": "YOUR_SDXL_CHECKPOINT.safetensors"}},
        "5": {"class_type": "EmptyLatentImage", "inputs": {"width": 1024, "height": 1024, "batch_size": 1}},
        "6": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
        "7": {"class_type": "CLIPTextEncode", "inputs": {"text": "", "clip": ["4", 1]}},
        "3": {"class_type": "KSampler", "inputs": {"seed": 0, "steps": 30, "cfg": 7.0, "sampler_name": "euler",
              "scheduler": "normal", "denoise": 1.0, "model": ["4", 0], "positive": ["6", 0],
              "negative": ["7", 0], "latent_image": ["5", 0]}},
        "8": {"class_type": "VAEDecode", "inputs": {"samples": ["3", 0], "vae": ["4", 2]}},
        "9": {"class_type": "SaveImage", "inputs": {"filename_prefix": "lodestar", "images": ["8", 0]}}
      }
    }
  },
  "localai": {
    "label": "LocalAI",
    "base": "http://127.0.0.1:8080",
    "health": "/readyz",
    "models": "/v1/models",
    "operations": ["text->image", "text->speech"],
    "endpoints": {"text->image": "/v1/images/generations", "text->speech": "/v1/audio/speech"},
    "probe_only": false,
    "experimental": false,
    "vram": []
  },
  "ollama_image": {
    "label": "Ollama image (experimental)",
    "base": "http://127.0.0.1:11434",
    "health": "/api/version",
    "models": "/api/tags",
    "operations": ["text->image"],
    "probe_only": true,
    "experimental": true,
    "vram": []
  }
}
