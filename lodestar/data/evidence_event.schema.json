{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lodestar.local/schemas/evidence_event.v1.json",
  "title": "EvidenceEvent",
  "description": "EvidenceEvent v1: one upsert or retract of an evidence record. lodestar/broker.py validate_event() checks the same rules by hand (no jsonschema dependency); test_lab_broker keeps the two in step.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "op", "workspace_id", "evidence_id", "revision", "provider_id",
               "source_id", "occurred_at", "policy_id"],
  "properties": {
    "schema_version": {"const": 1},
    "event_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "op": {"enum": ["upsert", "retract"]},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "evidence_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "revision": {"type": "integer", "minimum": 1},
    "provider_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "occurred_at": {"type": "string", "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"},
    "policy_id": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
